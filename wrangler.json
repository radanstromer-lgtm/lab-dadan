{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dadan-showcase",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "dadan.id",
      "custom_domain": true
    }
  ]
}
